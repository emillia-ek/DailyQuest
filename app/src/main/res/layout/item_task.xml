<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card_filled"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="16dp">

    <CheckBox
        android:id="@+id/checkbox_task"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/checkbox_dailyquest"
        android:button="@null"
        android:gravity="center"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:text="Task"
            android:textColor="@color/cobalt_blue"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"/>

        <TextView
            android:id="@+id/text_task_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/outfit"
            android:textColor="@color/gray_text"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginStart="12dp">

        <ImageView
            android:id="@+id/image_star"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_star"
            android:visibility="gone"
            app:tint="@color/accent_gold" />

        <TextView
            android:id="@+id/text_xp_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_xp"
            android:fontFamily="@font/outfit"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="+50 XP"
            android:textColor="@color/cobalt_blue"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
