<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="34dp"
        android:paddingBottom="98dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/card_blue"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/icon_light_fit" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="LVL 1"
                    android:textColor="@color/cobalt_blue"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/text_level_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="Beginner"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_multiplier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hud_chip"
                android:fontFamily="@font/outfit"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="x2 streak"
                android:textColor="@color/cobalt_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progress_xp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/progress_bar_custom" />

            <TextView
                android:id="@+id/text_xp_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/outfit"
                android:text="0 / 1000 XP"
                android:textColor="@color/gray_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/border_card_simple"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:text="Today's Tasks"
                android:textColor="@color/cobalt_blue"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/layout_today_tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="18dp">

            <zsk.mobilki.dailyquest.ui.home.FocusTimerView
                android:id="@+id/focus_timer_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="25:00"
                    android:textColor="@color/cobalt_blue"
                    android:textSize="76sp" />

                <TextView
                    android:id="@+id/text_focus_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="Ready for deep work"
                    android:textColor="@color/gray_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_xp_popup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/border_button_cream"
                android:fontFamily="@font/outfit"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="+25 XP"
                android:textColor="@color/cobalt_blue"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <!-- Primary button: Start / Pause / Resume -->
            <Button
                android:id="@+id/button_start_focus"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/quest_panel"
                android:fontFamily="@font/outfit"
                android:text="Start Focus Session"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:backgroundTint="@null" />

            <!-- Secondary control buttons: Reset and Stop -->
            <LinearLayout
                android:id="@+id/layout_secondary_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/button_reset_focus"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/border_button_cream"
                    android:fontFamily="@font/outfit"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textColor="@color/cobalt_blue"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/button_stop_focus"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/border_button_cream"
                    android:fontFamily="@font/outfit"
                    android:text="Save &amp; Stop"
                    android:textAllCaps="false"
                    android:textColor="@color/cobalt_blue"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_weight="1"
                android:background="@drawable/card_filled"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="0"
                    android:textColor="@color/cobalt_blue"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="streak"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/card_filled"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_sessions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="0"
                    android:textColor="@color/cobalt_blue"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="sessions"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/card_filled"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="0"
                    android:textColor="@color/cobalt_blue"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:text="coins"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
